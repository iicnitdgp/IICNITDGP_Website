# Docker / deploy environment for the whole app (client + server).
# This is the ONLY env file docker-compose uses — it is gitignored, just like
# .env, so put real values here. Load it explicitly:
#   docker compose --env-file .env.docker up --build

# ----- Server: URLs -----
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
CLIENT_BASE_URL=http://localhost:5173

# ----- Server: Database -----
MONGO_URI=

# ----- Server: App -----
PORT=8000
NODE_ENV=production

# ----- Server: JWT -----
JWT_ACCESS_SECRET=your-access-token
JWT_REFRESH_SECRET=your-refresh-token
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ----- Server: Mail -----
PassKey=

# ----- Server: Redis (the `redis` service defined in docker-compose.yml) -----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ----- Client: Vite build-time variables -----
# Vite inlines these into the static build, so they must be the URL the
# browser will use (not the internal docker service name) — keep in sync
# with BACKEND_URL above.
VITE_API_URL=http://localhost:8000/api
VITE_BACKEND_URI=http://localhost:8000
